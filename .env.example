# Example environment configuration
# Copy this file to .env and modify as needed

# AI Model Configuration
AI_MODEL=openai:gpt-3.5-turbo
# Alternative model examples:
# AI_MODEL=openai:gpt-4
# AI_MODEL=anthropic:claude-3-haiku-20240307
# AI_MODEL=groq:mixtral-8x7b-32768

# Custom/Local AI Webapp Configuration
# URL of your custom/local AI webapp (e.g., http://localhost:8000)
AI_WEBAPP_URL= 
# API key for your custom/local AI webapp
AI_API_KEY=

# API Keys (set these in your actual .env file)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000

# VOLTTRON Configuration
# GitHub organization for searching VOLTTRON agents
VOLTTRON_GITHUB_ORG=eclipse-volttron

# Wait times (in seconds)
# Time to wait for VOLTTRON platform to start up
VOLTTRON_STARTUP_WAIT=5
# Time to wait after agent installation
VOLTTRON_INSTALL_WAIT=2

# Timezone for VOLTTRON operations (default: UTC)
# Uncomment and set to your preferred timezone
# VOLTTRON_TIMEZONE=UTC
# VOLTTRON_TIMEZONE=US/Pacific
# VOLTTRON_TIMEZONE=America/New_York
# VOLTTRON_TIMEZONE=Europe/London