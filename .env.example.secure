# ============================================================================
# SECURE ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the actual .env file to git
# 2. NEVER share your API keys publicly
# 3. Copy this file to .env and fill in your actual credentials
# 4. Keep your .env file local only
# 5. Use different keys for development/production
#
# ============================================================================

# AI Model Configuration
# Choose your AI provider and model
AI_MODEL=openai:gpt-3.5-turbo

# Alternative model examples (uncomment and modify as needed):
# AI_MODEL=openai:gpt-4
# AI_MODEL=anthropic:claude-3-haiku-20240307
# AI_MODEL=groq:mixtral-8x7b-32768
# AI_MODEL=ollama:llama2
# AI_MODEL=claude-haiku-4-5-20251001-v1-birthright

# ============================================================================
# Custom AI Webapp Configuration (PNNL AI Incubator, etc.)
# ============================================================================
# Base URL (without /chat/completions - will be added automatically)
AI_WEBAPP_URL=https://your-ai-api-domain.com

# Your API key - KEEP THIS SECRET!
AI_API_KEY=your_api_key_here

# ============================================================================
# Standard AI Provider API Keys
# ============================================================================
# Only set the keys for providers you're using

# OpenAI API Key
# Get yours at: https://platform.openAI.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic API Key
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Groq API Key
# Get yours at: https://console.groq.com/
# GROQ_API_KEY=gsk_your_groq_key_here

# ============================================================================
# Ollama Configuration (for local AI)
# ============================================================================
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Server Configuration
# ============================================================================
HOST=127.0.0.1
PORT=8000

# ============================================================================
# VOLTTRON Configuration
# ============================================================================
# GitHub organization for searching VOLTTRON agents
VOLTTRON_GITHUB_ORG=eclipse-volttron

# Wait times (in seconds)
VOLTTRON_STARTUP_WAIT=5
VOLTTRON_INSTALL_WAIT=2

# Timezone for VOLTTRON operations
# VOLTTRON_TIMEZONE=UTC
# VOLTTRON_TIMEZONE=US/Pacific
# VOLTTRON_TIMEZONE=America/New_York
